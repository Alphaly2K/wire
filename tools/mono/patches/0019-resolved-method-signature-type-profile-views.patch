--- a/mono/metadata/unity-utils.c
+++ b/mono/metadata/unity-utils.c
@@ -2199,3 +2199,50 @@
 	}
 #undef WIRE_CLASS_FIELD
 }
+
+/* Wire diagnostic immutable views for already resolved metadata from this VM.
+ * Never pass guest/unvalidated pointers. The caller retains the owning domain
+ * and must revoke views before domain/image unload; these functions do not pin. */
+MONO_API gpointer
+wire_mono_profile_method_field (guint32 version, MonoMethod *method, guint32 field, guint32 *size)
+{
+    if (!size) return NULL;
+    *size = 0;
+    if (version != 1 || !method) return NULL;
+#define WIRE_METHOD_FIELD(id, member) case id: *size = sizeof (method->member); return &method->member
+    switch (field) {
+    WIRE_METHOD_FIELD (1, flags);
+    WIRE_METHOD_FIELD (2, iflags);
+    WIRE_METHOD_FIELD (3, token);
+    WIRE_METHOD_FIELD (4, klass);
+    WIRE_METHOD_FIELD (5, name);
+    WIRE_METHOD_FIELD (6, signature);
+    default: return NULL;
+    }
+#undef WIRE_METHOD_FIELD
+}
+MONO_API gpointer
+wire_mono_profile_signature_region (guint32 version, MonoMethodSignature *signature, guint32 field, guint32 *size)
+{
+    if (!size) return NULL;
+    *size = 0;
+    if (version != 1 || !signature) return NULL;
+    if (field == 1) {
+        *size = G_STRUCT_OFFSET (MonoMethodSignature, params);
+        return signature;
+    }
+    if (field == 2 && signature->param_count) {
+        *size = signature->param_count * sizeof (MonoType*);
+        return signature->params;
+    }
+    return NULL;
+}
+MONO_API gpointer
+wire_mono_profile_type_region (guint32 version, MonoType *type, guint32 *size)
+{
+    if (!size) return NULL;
+    *size = 0;
+    if (version != 1 || !type) return NULL;
+    *size = sizeof (MonoType);
+    return type;
+}
