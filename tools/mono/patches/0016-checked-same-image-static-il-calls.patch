     case MINT_LDNULL:
     case MINT_RET:
     case MINT_RET_VOID:
@@ -392,6 +393,8 @@
     case MINT_CLT_UN_R8:
     case MINT_ADD1_I4:
     case MINT_ADD1_I8:
+    case MINT_SUB1_I4:
