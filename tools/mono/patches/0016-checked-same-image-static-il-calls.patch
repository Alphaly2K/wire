     case MINT_NEG_I4:
     case MINT_NEG_I8:
     case MINT_NEG_R4:
@@ -4136,6 +4139,19 @@
 		}
 		MINT_IN_CASE(MINT_CALL) {
 			cmethod = (InterpMethod*)frame->imethod->data_items [ip [2]];
+            if (WIRE_SCOPED ()) {
