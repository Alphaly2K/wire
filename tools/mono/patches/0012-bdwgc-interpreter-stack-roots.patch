+/* Interpreter locals live in a separate data stack, outside pthread's
+ * native stack. Eager scanning copies their values into the collector's
+ * mark work now, instead of retaining addresses into a departing frame. */
+static void
+wire_push_interp_reference (gpointer *slot, gpointer unused)
+{
+	GC_push_all_eager (slot, slot + 1);
+}
