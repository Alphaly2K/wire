+/* An interpreter-owned local/byref is a native temporary, not a guest
+ * integer address. Admit only live frame storage, not a host page or stack. */
+static gboolean
+wire_memory_frame_owned (InterpFrame *frame, gpointer pointer, gsize length)
+{
+    gsize at = (gsize)pointer;
+    for (; frame; frame = frame->parent) {
+        gsize base = (gsize)frame->stack;
+        if (at >= base && at - base <= frame->imethod->alloca_size &&
+            length <= frame->imethod->alloca_size - (at - base))
+            return TRUE;
+    }
+    return FALSE;
+}
