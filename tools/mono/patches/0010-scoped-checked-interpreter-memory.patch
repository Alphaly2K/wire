+int
+wire_mono_prepare_memory_adapter (guint32 version)
+{
+    if (version != 1 || mono_get_root_domain ())
+        return -1;
+    mono_interp_opt = INTERP_OPT_NONE;
+    return 0;
+}
+
+int
+wire_mono_set_memory_adapter (guint32 version, MonoImage *image,
+    WireMonoMemoryAccess access, gpointer user_data)
+{
+    if (version != 1 || (!!image != !!access) || (access && mono_interp_opt != INTERP_OPT_NONE))
+        return -1;
+    wire_memory_image = image;
+    wire_memory_access = access;
+    wire_memory_user_data = user_data;
+    return 0;
