+/* wire prototype: bind a precompiled typed entry for this exact method.
+ * 0 delegates to the normal loader, 1 binds a non-null target, -1 rejects.
+ * Installed once. Cached targets and the callback must outlive this VM. */
+typedef int (*WirePInvokeAdapter) (MonoMethod *method, const char *scope,
+                                 const char *entry, guint32 flags, gpointer *target);
+MONO_API int wire_mono_install_pinvoke_adapter (guint32 version, WirePInvokeAdapter adapter);
+
 typedef void * (*PInvokeOverrideFn) (const char *libraryName, const char *entrypointName);
 
