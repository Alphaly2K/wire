@@ -62,6 +62,17 @@
 static MonoDl *internal_module; // used when pinvoking `__Internal`
 
 static PInvokeOverrideFn pinvoke_override;
+static gpointer volatile wire_pinvoke_adapter;
+
+int
+wire_mono_install_pinvoke_adapter (guint32 version, WirePInvokeAdapter adapter)
+{
+	if (version != 1 || !adapter)
+		return -1;
+	/* Immutable after installation, including across domain reloads. */
+	return mono_atomic_cas_ptr (&wire_pinvoke_adapter, (gpointer)adapter, NULL) == NULL ? 0 : -1;
+}
