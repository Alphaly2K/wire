+                                      WireMonoScalarRead read)
+{
+    if (version != 1 || !method || !read || !mono_get_root_domain () ||
+        method->wrapper_type != MONO_WRAPPER_NONE || m_class_is_valuetype (method->klass))
+        return 1;
