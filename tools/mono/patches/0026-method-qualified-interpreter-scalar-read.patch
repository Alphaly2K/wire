+    if (!signature || !signature->hasthis || signature->param_count ||
+        signature->ret->byref || signature->ret->type != MONO_TYPE_I4)
+        return 2;
+    if (mono_domain_get () != mono_get_root_domain ())
+        return 4;
+    InterpMethod *imethod = lookup_imethod (mono_domain_get (), method);
+    if (imethod && imethod->transformed)
+        return 5; /* Never admit an already cached unchecked body. */
+    WireScalarReadBinding *binding = g_new0 (WireScalarReadBinding, 1);
+    binding->method = method;
+    binding->read = read;
+    if (mono_atomic_cas_ptr (&wire_scalar_read_binding, binding, NULL)) {
+        g_free (binding);
+        return 3;
+    }
+    return 0;
+}
