--- a/mono/metadata/unity-utils.c
+++ b/mono/metadata/unity-utils.c
@@ -181,6 +181,69 @@
 	HANDLE_FUNCTION_ENTER ();
 	MonoArrayHandle result = mono_custom_attrs_construct_by_type (cinfo, NULL, error);
 	HANDLE_FUNCTION_RETURN_OBJ (result);
+}
+
+/* Wire checked attribute boundary: callers own cinfo, and root returned
+ * managed values before another collecting operation. Only an error code
+ * crosses this ABI; MonoError private storage always stays inside Mono. */
+static guint16
+wire_mono_attrs_finish (MonoError *error)
+{
+    guint16 code = mono_error_get_error_code (error);
+    mono_error_cleanup (error);
+    return code;
+}
+
+MONO_API MonoCustomAttrInfo*
+wire_mono_custom_attrs_from_class_checked (MonoClass *klass, guint16 *status)
+{
+    if (!status) return NULL;
+    *status = MONO_ERROR_ARGUMENT_NULL;
+    if (!klass) return NULL;
+    ERROR_DECL (error);
+    MonoCustomAttrInfo *result = mono_custom_attrs_from_class_checked (klass, error);
+    *status = wire_mono_attrs_finish (error);
+    if (*status && result) { mono_custom_attrs_free (result); result = NULL; }
+    return result;
+}
+
+MONO_API MonoCustomAttrInfo*
+wire_mono_custom_attrs_from_field_checked (MonoClass *klass, MonoClassField *field, guint16 *status)
+{
+    if (!status) return NULL;
+    *status = MONO_ERROR_ARGUMENT_NULL;
+    if (!klass || !field) return NULL;
+    ERROR_DECL (error);
+    MonoCustomAttrInfo *result = mono_custom_attrs_from_field_checked (klass, field, error);
+    *status = wire_mono_attrs_finish (error);
+    if (*status && result) { mono_custom_attrs_free (result); result = NULL; }
+    return result;
+}
+
+MONO_API MonoObject*
+wire_mono_custom_attrs_get_attr_checked (MonoCustomAttrInfo *info, MonoClass *klass, guint16 *status)
+{
+    if (!status) return NULL;
+    *status = MONO_ERROR_ARGUMENT_NULL;
+    if (!info || !klass) return NULL;
+    ERROR_DECL (error);
+    MonoObject *result = mono_custom_attrs_get_attr_checked (info, klass, error);
+    *status = wire_mono_attrs_finish (error);
+    return *status ? NULL : result;
+}
+
+MONO_API MonoArray*
+wire_mono_custom_attrs_construct_checked (MonoCustomAttrInfo *info, guint16 *status)
+{
+    if (!status) return NULL;
+    *status = MONO_ERROR_ARGUMENT_NULL;
+    if (!info) return NULL;
+    HANDLE_FUNCTION_ENTER ();
+    ERROR_DECL (error);
+    MonoArrayHandle result = mono_custom_attrs_construct_by_type (info, NULL, error);
+    *status = wire_mono_attrs_finish (error);
+    if (*status) result = MONO_HANDLE_CAST (MonoArray, mono_new_null ());
+    HANDLE_FUNCTION_RETURN_OBJ (result);
 }
 
 MONO_API gboolean
